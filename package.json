{
  "name": "cookiecat",
  "version": "0.1.0",
  "description": "Cookiecat \u2014 Cursor/Agent MCP plugin for RelayRouter (OpenAI-compatible chat + models)",
  "type": "module",
  "main": "dist/cookiecat.mjs",
  "bin": {
    "cookiecat": "dist/cookiecat.mjs"
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "start": "node dist/cookiecat.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/cookiecat.mjs --banner:js=\"#!/usr/bin/env node\""
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "cookiecat",
    "relayrouter",
    "cursor-plugin",
    "openai-compatible"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "esbuild": "^0.25.0"
  }
}
